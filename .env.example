# ------------------------------------------------------------------
# gokhancoskun.com — ornek ortam dosyasi
# Kopyala: cp .env.example .env  ve degerleri doldur.
# .env asla git'e eklenmez.
# ------------------------------------------------------------------

# --- Uygulama ---
APP_NAME="Gökhan Coşkun"
APP_ENV=production
DEBUG=false
SITE_URL=https://gokhancoskun.com
PANEL_URL=https://panel.gokhancoskun.com
HOST=127.0.0.1
PORT=8002

# --- PostgreSQL ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=gokhancoskundb
POSTGRES_USER=gokhancoskun
POSTGRES_PASSWORD=degistir
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5
# PgBouncer kullaniliyorsa doldur (bos ise dogrudan PostgreSQL'e baglanilir)
PGBOUNCER_HOST=
PGBOUNCER_PORT=

# --- Valkey / Redis ---
VALKEY_HOST=127.0.0.1
VALKEY_PORT=6379
VALKEY_DB=3
VALKEY_PASSWORD=
CACHE_DEFAULT_TTL=300

# --- Guvenlik ---
# python3.12 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=degistir
# python3.12 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=degistir
JWT_ALGORITHM=HS256
TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=gc_session
COOKIE_SECURE=true

# --- Rate limit (sliding window) ---
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
LOGIN_RATE_LIMIT_REQUESTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Medya ---
MEDIA_ROOT=/opt/gokhancoskun/media
MEDIA_URL=/media
MAX_UPLOAD_MB=8

# --- E-posta (iletisim formu bildirimi) ---
# Sunucudaki Postfix'e teslim edilir; kimlik dogrulama gerekmez.
# Harici SMTP kullanilacaksa SMTP_USER/SMTP_PASSWORD doldur, STARTTLS'i ac.
SMTP_HOST=127.0.0.1
SMTP_PORT=25
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TIMEOUT=15
MAIL_FROM=siteform@gokhancoskun.com
MAIL_FROM_NAME="gokhancoskun.com iletişim formu"
MAIL_TO=gokhancoskun1983@gmail.com

# --- Form bot korumasi (captcha yerine imzali zaman token'i) ---
FORM_MIN_SECONDS=3
FORM_MAX_SECONDS=3600

# --- Ilk yonetici (yalnizca migration/seed sirasinda kullanilir) ---
ADMIN_USERNAME=gokhan
ADMIN_EMAIL=info@gokhancoskun.com
ADMIN_PASSWORD=degistir

# --- MCP istemcisi (mcp_server/ tarafindan okunur) ---
GC_API_BASE=https://panel.gokhancoskun.com
GC_API_TOKEN=degistir
